{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codex-system-contract.invalid/responses/responses-request-semantics-v2.schema.json",
  "title": "Codex Responses request and transport lifecycle semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ownership",
    "request_shape",
    "construction",
    "http_transport",
    "websocket_transport",
    "evidence",
    "semantic_complete",
    "semantic_digest",
    "transport_lifecycle"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.codex-system-contract.invalid/responses/responses-request-semantics-v2.schema.json"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "ownership": {
      "$ref": "#/$defs/ownership"
    },
    "request_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_fields",
        "websocket_fields",
        "websocket_envelope_type",
        "endpoint_paths"
      ],
      "properties": {
        "http_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 8,
          "uniqueItems": true
        },
        "websocket_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 10,
          "uniqueItems": true
        },
        "websocket_envelope_type": {
          "const": "response.create"
        },
        "endpoint_paths": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "construction": {
      "$ref": "#/$defs/semanticSection"
    },
    "http_transport": {
      "$ref": "#/$defs/semanticSection"
    },
    "websocket_transport": {
      "$ref": "#/$defs/semanticSection"
    },
    "evidence": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "$ref": "#/$defs/evidence"
      }
    },
    "semantic_complete": {
      "type": "boolean"
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "startup_prewarm",
        "continuation",
        "state_scope",
        "fallback",
        "terminal_socket"
      ],
      "properties": {
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "websocket_preferred_when",
            "http_fallback",
            "path",
            "scheme_pairing"
          ],
          "properties": {
            "websocket_preferred_when": {
              "type": "string",
              "minLength": 1
            },
            "http_fallback": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "const": "/responses"
            },
            "scheme_pairing": {
              "type": "object",
              "additionalProperties": true,
              "minProperties": 4
            }
          }
        },
        "startup_prewarm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheduled_during_session_initialization",
            "occurs_before_initial_history_restore",
            "logical_conversation_input",
            "uses_normal_base_instructions_and_tool_snapshot",
            "wire_type",
            "generate",
            "waits_for",
            "continuation_baseline"
          ],
          "properties": {
            "scheduled_during_session_initialization": {
              "const": true
            },
            "occurs_before_initial_history_restore": {
              "const": true
            },
            "logical_conversation_input": {
              "const": "empty"
            },
            "uses_normal_base_instructions_and_tool_snapshot": {
              "const": true
            },
            "wire_type": {
              "const": "response.create"
            },
            "generate": {
              "const": false
            },
            "waits_for": {
              "const": "response.completed"
            },
            "continuation_baseline": {
              "const": "completed response id"
            }
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligibility",
            "eligible_wire",
            "ineligible_wire"
          ],
          "properties": {
            "eligibility": {
              "type": "string",
              "minLength": 1
            },
            "eligible_wire": {
              "type": "string",
              "minLength": 1
            },
            "ineligible_wire": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "state_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_state",
            "websocket_connection",
            "fallback_state",
            "fallback_sticky_across_turns"
          ],
          "properties": {
            "turn_state": {
              "type": "string",
              "minLength": 1
            },
            "websocket_connection": {
              "type": "string",
              "minLength": 1
            },
            "fallback_state": {
              "type": "string",
              "minLength": 1
            },
            "fallback_sticky_across_turns": {
              "const": true
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upgrade_required_426",
            "retryable_failure_before_budget",
            "retry_budget_exhausted",
            "warning_prefix",
            "unbounded_connection_retry_exception"
          ],
          "properties": {
            "upgrade_required_426": {
              "type": "string",
              "minLength": 1
            },
            "retryable_failure_before_budget": {
              "type": "string",
              "minLength": 1
            },
            "retry_budget_exhausted": {
              "type": "string",
              "minLength": 1
            },
            "warning_prefix": {
              "type": "string",
              "minLength": 1
            },
            "unbounded_connection_retry_exception": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "terminal_socket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on_stream_error",
            "graceful_close_handshake",
            "drop_behavior",
            "special_retryable_codes"
          ],
          "properties": {
            "on_stream_error": {
              "type": "string",
              "minLength": 1
            },
            "graceful_close_handshake": {
              "const": false
            },
            "drop_behavior": {
              "type": "string",
              "minLength": 1
            },
            "special_retryable_codes": {
              "const": [
                "websocket_connection_limit_reached",
                "previous_response_not_found"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns",
        "does_not_own"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "does_not_own": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "semanticSection": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_spec_id",
        "path",
        "sha256",
        "git_blob_sha",
        "symbol"
      ],
      "properties": {
        "source_spec_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_blob_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
