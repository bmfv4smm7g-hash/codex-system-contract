{
  "$id": "https://schemas.codex-system-contract.invalid/policy/execution-policy-semantics-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex execution authority semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ownership",
    "permission_model",
    "selection",
    "managed_requirements",
    "runtime_resolution",
    "exec_policy",
    "evidence",
    "semantic_complete",
    "semantic_digest"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.codex-system-contract.invalid/policy/execution-policy-semantics-v1.schema.json"
    },
    "schema_version": {"const": "1.0.0"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "does_not_own"],
      "properties": {
        "owns": {"type": "array", "items": {"type": "string"}, "minItems": 5, "uniqueItems": true},
        "does_not_own": {"type": "array", "items": {"type": "string"}, "minItems": 4, "uniqueItems": true}
      }
    },
    "permission_model": {
      "type": "object",
      "required": ["runtime_authority", "sandbox_enforcement", "builtin_profiles", "identity_sidecar", "per_command_overlay", "evidence"]
    },
    "selection": {
      "type": "object",
      "required": ["selection_order", "managed_constraint_behavior", "implicit_builtin_rule", "named_profile_compilation", "runtime_snapshot", "evidence"]
    },
    "managed_requirements": {
      "type": "object",
      "required": ["authority_sources", "constrained_fields", "excluded_managed_fields", "evidence"]
    },
    "runtime_resolution": {
      "type": "object",
      "required": ["approval_policy", "permission_profile", "derived_policies", "additional_permissions", "prefix_rule_gate", "boundary", "evidence"]
    },
    "exec_policy": {
      "type": "object",
      "required": ["decision_space", "inputs", "approval_intersection", "explicit_allow_rule", "reusable_amendments", "evidence"]
    },
    "evidence": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {
        "type": "object",
        "required": ["source_spec_id", "path", "sha256", "git_blob_sha", "symbol"]
      }
    },
    "semantic_complete": {"type": "boolean"},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
