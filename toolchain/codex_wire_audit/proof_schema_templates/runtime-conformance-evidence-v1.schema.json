{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codex-system-contract.invalid/runtime/runtime-conformance-evidence-v1.schema.json",
  "title": "Codex bounded runtime-conformance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "profile_id",
    "report_sha256",
    "required_scenarios",
    "scope",
    "observer",
    "scenarios",
    "status"
  ],
  "properties": {
    "$schema": {"const": "https://schemas.codex-system-contract.invalid/runtime/runtime-conformance-evidence-v1.schema.json"},
    "format": {"const": "codex-runtime-conformance/v1"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "required_scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_commit", "build_kind", "build_sha256", "platform", "account_class", "network_class"],
      "properties": {
        "source_repository": {"$ref": "#/$defs/token"},
        "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "build_kind": {"enum": ["source", "binary", "package"]},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch"],
          "properties": {
            "os": {"$ref": "#/$defs/token"},
            "arch": {"$ref": "#/$defs/token"}
          }
        },
        "account_class": {"enum": ["none", "consumer", "workspace", "api", "unknown"]},
        "network_class": {"enum": ["offline", "local_fixture", "external", "unknown"]}
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "version", "sha256", "run_id"],
      "properties": {
        "harness": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/token"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"$ref": "#/$defs/token"}
      }
    },
    "scenarios": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"}
    },
    "status": {"enum": ["complete", "partial"]}
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_code"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "status": {"enum": ["passed", "failed", "blocked"]},
        "evidence_code": {"$ref": "#/$defs/token"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "media_type", "sha256"],
      "properties": {
        "role": {"$ref": "#/$defs/token"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[^/\\s]+/[^\\s]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "observation_kind", "assertions", "artifacts"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "status": {"enum": ["passed", "failed", "blocked"]},
        "observation_kind": {"enum": ["local_fixture", "integration", "live"]},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  }
}
