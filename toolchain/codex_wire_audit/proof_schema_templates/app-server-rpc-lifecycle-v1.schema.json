{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codex-system-contract.invalid/app-server/rpc-lifecycle-v1.schema.json",
  "title": "Codex app-server RPC lifecycle semantics",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "ownership", "rpc_envelope", "request_dispatch", "notification_dispatch", "thread", "turn", "pagination", "evidence", "semantic_complete", "semantic_digest"],
  "properties": {
    "$schema": {"const": "https://schemas.codex-system-contract.invalid/app-server/rpc-lifecycle-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "ownership": {"$ref": "#/$defs/ownership"},
    "rpc_envelope": {"type": "object", "minProperties": 5, "additionalProperties": true},
    "request_dispatch": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/request"}},
    "notification_dispatch": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/notification"}},
    "thread": {"type": "object", "minProperties": 8, "additionalProperties": true},
    "turn": {"type": "object", "minProperties": 6, "additionalProperties": true},
    "pagination": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string"}},
    "evidence": {"type": "object", "minProperties": 6, "additionalProperties": {"$ref": "#/$defs/evidence"}},
    "semantic_complete": {"type": "boolean"},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "does_not_own"],
      "properties": {
        "owns": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "does_not_own": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "method", "params", "response", "serialization"],
      "properties": {
        "variant": {"type": "string", "minLength": 1},
        "method": {"type": "string", "pattern": "^(thread|turn)/"},
        "params": {"type": "string", "minLength": 1},
        "response": {"type": "string", "minLength": 1},
        "serialization": {"type": "string", "minLength": 1}
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "method", "payload"],
      "properties": {
        "variant": {"type": "string", "minLength": 1},
        "method": {"type": "string", "pattern": "^(thread|turn|item)/"},
        "payload": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_spec_id", "path", "sha256", "git_blob_sha", "symbol"],
      "properties": {
        "source_spec_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_sha": {"type": ["string", "null"]},
        "symbol": {"type": "string", "minLength": 1}
      }
    }
  }
}
